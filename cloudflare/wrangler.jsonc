// Remixt on Cloudflare: a small Worker that forwards every request to one
// container running the repo's Dockerfile (Next.js server, yt-dlp).
// The database is Neon (DATABASE_URL) and stems live in R2 (R2_*), so the
// container keeps nothing on its own disk. Deploy with ./deploy.sh.
{
  "name": "remixt",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "remixt.app", "custom_domain": true },
    { "pattern": "www.remixt.app", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Remixt",
      "image": "../Dockerfile",
      "image_build_context": "..",
      // Build-time only: sitemap.xml and robots.txt are prerendered by
      // `next build`, so they need the real domain then (not at runtime).
      "image_vars": { "PUBLIC_BASE_URL": "https://remixt.app" },
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "REMIXT", "class_name": "Remixt" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Remixt"] }],
  "vars": {
    "BASE_URL": "https://remixt.app",
    "PUBLIC_BASE_URL": "https://remixt.app"
  }
}

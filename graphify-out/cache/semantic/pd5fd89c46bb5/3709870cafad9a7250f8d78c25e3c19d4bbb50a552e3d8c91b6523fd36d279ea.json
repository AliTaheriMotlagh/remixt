{"nodes": [{"id": "deploy_deploying_remixt", "label": "Deploying Remixt (deployment guide)", "file_type": "document", "source_file": "DEPLOY.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_in_browser_song_splitting", "label": "In-browser song splitting", "file_type": "rationale", "source_file": "DEPLOY.md", "source_location": "L4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Songs are split into vocals and beat in the listener's browser so the server only handles accounts, library and remixes; this lets Remixt run on free hosting and the original file never leaves the device."}, {"id": "deploy_mobile_splitter_on_demand", "label": "On-demand splitter loading on phones/tablets", "file_type": "rationale", "source_file": "DEPLOY.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splitter is not preloaded on mobile and is unloaded after use because iOS reloads a tab that holds too much memory; songs limited to 10 min on mobile (15 on desktop)."}, {"id": "deploy_demucs_onnx_model", "label": "Demucs ONNX model (htdemucs_embedded.onnx, ~172 MB)", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_onnx_runtime_web", "label": "ONNX Runtime Web (~28 MB, WebGPU/WASM)", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_yt_dlp_link_import", "label": "Song import from link via yt-dlp (/api/import)", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "YouTube links are off by default because YouTube blocks downloads from cloud data centres; YTDLP_PROXY or YTDLP_COOKIES re-enable them. Imported audio is kept briefly under imports/ and swept after an hour."}, {"id": "deploy_vercel_free_setup", "label": "Free on Vercel with Neon and Vercel Blob", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended: app, database and stems all managed from one Vercel dashboard, no credit card; Vercel Hobby is non-commercial only."}, {"id": "deploy_neon_postgres_database", "label": "Neon Postgres database (Neon Free)", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L121", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_vercel_blob_stem_store", "label": "Vercel Blob stem store", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public mode streams directly from Blob CDN (more efficient); private mode makes the app proxy stems 4 MB at a time."}, {"id": "deploy_cloudflare_r2_stem_store", "label": "Cloudflare R2 stem storage", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L177", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "10 GB free but needs a payment card; when R2_BUCKET is set it takes priority over Blob."}, {"id": "deploy_pooled_vs_unpooled_database_url", "label": "DATABASE_URL (pooled) vs DATABASE_URL_UNPOOLED", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App uses the pooled URL; migrations via scripts/migrate.mjs use the unpooled URL."}, {"id": "deploy_schema_migration", "label": "Schema setup (web/scripts/schema.sql, scripts/migrate.mjs)", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L129", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema is applied on every Docker start and is idempotent."}, {"id": "deploy_oracle_cloud_always_free", "label": "Oracle Cloud Always Free ARM server setup", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L203", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_docker_all_in_one_image", "label": "All-in-one Docker image (app + Postgres + Caddy, /data volume)", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L308", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything that must survive updates (database, stems, session secret, TLS certs) lives in one /data volume."}, {"id": "deploy_caddy_https", "label": "Caddy automatic HTTPS (DOMAIN env var)", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L368", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_duckdns_free_domain", "label": "DuckDNS free domain", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L255", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_cloudflare_tunnel_deploy", "label": "Cloudflare Tunnel deployment (no open ports)", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L337", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If outbound UDP is blocked, add --protocol http2."}, {"id": "deploy_ai_co_producer", "label": "AI co-producer (Ask AI tab, per-user Anthropic/OpenRouter keys)", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": "L378", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs on each person's own key so the site does not pay; keys encrypted with AI_KEY_SECRET (web/src/lib/aiKeys.ts); OpenRouter called server-side only (web/src/lib/openrouter.ts)."}, {"id": "deploy_public_launch_checklist", "label": "Before opening to the public (copyright, no quotas, non-commercial)", "file_type": "rationale", "source_file": "DEPLOY.md", "source_location": "L408", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uploads of commercial songs need terms of use and takedown contact; anyone can sign up with no per-user quota; Vercel free plan is non-commercial."}], "edges": [{"source": "deploy_deploying_remixt", "target": "deploy_vercel_free_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "deploy_deploying_remixt", "target": "deploy_oracle_cloud_always_free", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "deploy_deploying_remixt", "target": "deploy_docker_all_in_one_image", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "deploy_deploying_remixt", "target": "deploy_public_launch_checklist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "deploy_in_browser_song_splitting", "target": "deploy_demucs_onnx_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "deploy_in_browser_song_splitting", "target": "deploy_onnx_runtime_web", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "deploy_mobile_splitter_on_demand", "target": "deploy_in_browser_song_splitting", "relat
.DS_Store
.npm-cache/
.local-tools/
separation-service/venv/
separation-service/__pycache__/
separation-service/*.pyc
# Local stems (STORAGE_DIR). Anchored: an unanchored rule also hid
# web/src/app/storage/, so "Saved on this device" 404ed when deployed.
/storage/
.claude/
**/.claude/

# Cloudflare tunnel credentials for ./share.sh — never commit.
.share.env

# graphify: only the report is shared. graph.json/html, cache and transcripts
# are large, regenerate on every rebuild, and are machine-specific.
graphify-out/*
!graphify-out/GRAPH_REPORT.md

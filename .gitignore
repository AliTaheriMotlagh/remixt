.DS_Store
.npm-cache/
.local-tools/
separation-service/venv/
separation-service/__pycache__/
separation-service/*.pyc
# Local stems (STORAGE_DIR). Anchored: an unanchored rule also hid
# web/src/app/storage/, so "Saved on this device" 404ed when deployed.
/storage/
.claude/
**/.claude/

# Cloudflare tunnel credentials for ./share.sh — never commit.
.share.env

# graphify: all local. The post-commit hook rebuilds the graph and rewrites
# GRAPH_REPORT.md after every commit, so a tracked report left the tree
# dirty after each commit and needed a "graph" commit of its own.
graphify-out/

# Next.js docs copied from node_modules/next/dist/docs by
# web/scripts/copy-next-docs.mjs on every npm install.
web/.next-docs/

